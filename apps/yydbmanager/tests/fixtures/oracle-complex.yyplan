        "Query.Text": "SELECT a.GRP, COUNT(*) AS N, SUM(b.AMOUNT) AS TOTAL FROM YYDB_PLAN_A a JOIN YYDB_PLAN_B b ON a.ID=b.ID WHERE b.AMOUNT>10 GROUP BY a.GRP ORDER BY SUM(b.AMOUNT) DESC",

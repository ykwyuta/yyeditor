// RIFF/WAVE chunks: payload bytes are skipped to support large sound files.
LittleEndian();
char riff[4];
uint riffSize;
char wave[4];
typedef struct {
    char id[4];
    uint size;
    local uint payloadStart = FTell();
    if (id[0] == 102 && id[1] == 109 && id[2] == 116 && id[3] == 32) {
        ushort format;
        ushort channels;
        uint sampleRate;
        uint byteRate;
        ushort blockAlign;
        ushort bitsPerSample;
    }
    FSeek(payloadStart + size + (size & 1));
} CHUNK;
while (!FEof()) CHUNK chunk;
